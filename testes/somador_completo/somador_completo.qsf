# Projeto de teste do bloco 'somador_completo'
# O circuito NAO fica aqui: ele esta na biblioteca, em lib/somador_completo.bdf
# Editar o bloco por este projeto altera o arquivo da biblioteca.
# Esta pasta guarda so o que e do teste: projeto, tabela verdade e simulacao (somador_completo.vwf)
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY somador_completo
set_global_assignment -name BDF_FILE ../../lib/somador_completo.bdf
set_global_assignment -name SEARCH_PATH ../../lib
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name LAST_QUARTUS_VERSION "21.1.1 Lite Edition"