# Projeto de teste do bloco 'comparador_igual'
# O circuito NAO fica aqui: ele esta na biblioteca, em lib/comparador_igual.bdf
# Editar o bloco por este projeto altera o arquivo da biblioteca.
# Esta pasta guarda so o que e do teste: projeto, tabela verdade e simulacao (comparador_igual.vwf)
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY comparador_igual
set_global_assignment -name BDF_FILE ../../lib/comparador_igual.bdf
set_global_assignment -name SEARCH_PATH ../../lib
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
