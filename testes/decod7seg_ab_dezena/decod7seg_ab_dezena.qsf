# Projeto de teste do bloco 'decod7seg_ab_dezena'
# O circuito NAO fica aqui: ele esta na biblioteca, em lib/decod7seg_ab_dezena.bdf
# Editar o bloco por este projeto altera o arquivo da biblioteca.
# Esta pasta guarda so o que e do teste: projeto, tabela verdade e simulacao (decod7seg_ab_dezena.vwf)
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY decod7seg_ab_dezena
set_global_assignment -name BDF_FILE ../../lib/decod7seg_ab_dezena.bdf
set_global_assignment -name SEARCH_PATH ../../lib
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
