digraph U {
  rankdir=LR; nodesep=0.25; ranksep=0.7; splines=spline; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#334155", fontname="Helvetica", fontsize=10.5, penwidth=1.2];
  edge [color="#334155", fontname="Helvetica", fontsize=8.5, arrowsize=0.7];
  AB [label="A[4..0]\nB[4..0]", shape=box, style="filled", fillcolor="#e0e7ff", height=4.2];
  S [label="S[2..0]", shape=box, style="filled", fillcolor="#e0e7ff", height=1.6];
  subgraph cluster_v { label="resultados vetoriais (F)"; fontname="Helvetica-Bold"; fontsize=10; style="rounded,dashed"; color="#94a3b8";
    SS [label="somador_subtrator\n(comp2 ×2, somador6, c2_para_sm)", fillcolor="#fde68a"];
    C2 [label="comp2 (C2 de B)", fillcolor="#fde68a"];
    AND [label="op_and", fillcolor="#fde68a"]; XOR [label="op_xor", fillcolor="#fde68a"];
  }
  subgraph cluster_c { label="comparações (STATUS)"; fontname="Helvetica-Bold"; fontsize=10; style="rounded,dashed"; color="#94a3b8";
    EQ [label="comparador_igual", fillcolor="#c7d2fe"];
    GT [label="comp_maior(A, B)", fillcolor="#c7d2fe"];
    LT [label="comp_maior(B, A)", fillcolor="#c7d2fe"];
  }
  DS [label="decodificador_saida", fillcolor="#f1f5f9"];
  DC [label="decodificador_comparadores", fillcolor="#f1f5f9"];
  DEN [label="DISP_EN = S2'·S1'", fillcolor="#f1f5f9"];
  MS [label="mux_saida\n(4:1, 6 bits)", fillcolor="#dcfce7"];
  FEN [label="6 × AND com F_EN(S)\n(zera F nas comparações)", fillcolor="#f1f5f9"];
  MC [label="mux_comparadores", fillcolor="#dcfce7"];
  F [label="F[5..0]", shape=plaintext, style=""]; ST [label="STATUS", shape=plaintext, style=""]; DE [label="DISP_EN", shape=plaintext, style=""];
  AB -> SS; AB -> C2 [label="B"]; AB -> AND; AB -> XOR; AB -> EQ; AB -> GT; AB -> LT;
  S -> SS [label="S[0]", constraint=false];
  SS -> MS [label="00"]; C2 -> MS [label="01"]; AND -> MS [label="10"]; XOR -> MS [label="11"];
  S -> DS; DS -> MS [label="seleção"]; MS -> FEN; FEN -> F;
  EQ -> MC [label="F2F1 = 10"]; GT -> MC [label="01"]; LT -> MC [label="11"]; S -> DC; DC -> MC [label="F2 F1"]; MC -> ST;
  S -> DEN; DEN -> DE;
  { rank=same; AB; S; }
}
